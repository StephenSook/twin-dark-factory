#!/bin/sh
# Local guard for the result repository (installed as .git/hooks/pre-commit, never committed).
# 1. Every commit is authored by a named seat or by the human owner.
# 2. A seat may only change files inside stage folders.
SEATS="coordinator modeler builder surface gatekeeper"
HUMAN="Stephen Sookra"

name=$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed 's/ <.*//')
if [ -z "$name" ]; then
  echo "commit refused: no author. Commit with: git -c user.name=<your seat> -c user.email=<your seat>@band.local commit ..." >&2
  exit 1
fi
[ "$name" = "$HUMAN" ] && exit 0

is_seat=0
for s in $SEATS; do [ "$name" = "$s" ] && is_seat=1; done
if [ $is_seat -ne 1 ]; then
  echo "commit refused: author '$name' is not a seat ($SEATS)." >&2
  exit 1
fi

outside=$(git diff --cached --name-only | grep -v '^stage-[0-9][0-9]*/' || true)
if [ -n "$outside" ]; then
  echo "commit refused: seat '$name' may only change files inside stage folders. Outside:" >&2
  echo "$outside" >&2
  exit 1
fi

# 3. No nested repositories (gitlinks) and no bytecode caches in any commit.
nested=$(git diff --cached --diff-filter=AM --raw | awk '$2 == "160000" {print $6}')
junk=$(git diff --cached --diff-filter=AM --name-only | grep -E '(^|/)(__pycache__/|\.pytest_cache/)|\.pyc$' || true)
if [ -n "$nested$junk" ]; then
  echo "commit refused: nested repository or cache files staged. Keep scratch copies under the system temp directory:" >&2
  echo "$nested" "$junk" >&2
  exit 1
fi
exit 0
